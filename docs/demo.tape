Output "docs/demo.gif"
Set Shell zsh
Set FontSize 15
Set Width 1560
Set Height 610
Set Padding 24
Set Theme "Catppuccin Mocha"
Set TypingSpeed 70ms
Env PATH "/Users/apple/.local/bin:/usr/local/bin:/opt/homebrew/bin:/usr/bin:/bin"
Hide
Type "export PS1='~/myapp $ ' && clear"
Enter
Sleep 500ms
Show
Sleep 800ms
Type "dockdoctor"
Sleep 400ms
Enter
Sleep 7s
